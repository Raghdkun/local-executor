{
  "name": "local-executor",
  "version": "0.3.0",
  "description": "Set up a planner → local executor → auditor AI coding pipeline: installs Ollama, picks a right-sized open-weight model for your hardware, and installs the skill into Claude Code, Codex CLI, Cursor, and Windsurf.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lex": "dist/cli.js",
    "local-executor": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ollama",
    "local-llm",
    "claude-code",
    "codex",
    "cursor",
    "windsurf",
    "ai-coding",
    "agent",
    "qwen",
    "gemma",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raghdkun/local-executor.git"
  },
  "bugs": {
    "url": "https://github.com/Raghdkun/local-executor/issues"
  },
  "homepage": "https://github.com/Raghdkun/local-executor#readme",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "systeminformation": "^5.33.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "local-executor contributors"
}
