{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "skill/runtime/**",
      "*.ts",
      "*.json",
      "!package-lock.json",
      "!dist",
      "!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noConsole": "off" },
      "style": { "useTemplate": "warn", "noNonNullAssertion": "error" },
      "complexity": { "noForEach": "off" }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  }
}
